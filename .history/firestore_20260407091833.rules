rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember(projectId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function isLeader(projectId) {
      // Check if user is a leader in the members subcollection
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == 'leader';
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Projects Collection
    match /projects/{projectId} {
      // Create: Allow any auth user to create a project
      allow create: if isAuthenticated();
      
      // Read: Allow if user is a member (or maybe allow reading just the doc to join? 
      // Actually, to join, we query by joinCode. Query rules are tricky. 
      // Simplified: Allow read if authenticated (to check join code) OR is member.
      allow read: if isAuthenticated();

      // Update: Only leader can update project settings
      allow update: if isLeader(projectId);

      // Members Subcollection
      match /members/{memberId} {
        // Read: Project members can read member list
        allow read: if isMember(projectId) || (isAuthenticated() && request.auth.uid == memberId);
        
        // Write: 
        // 1. User can add themselves (join)
        // 2. Leader can update roles
        allow write: if (request.auth.uid == memberId) || isLeader(projectId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        // Read: Project members can read tasks
        allow read: if isMember(projectId);

        // Create: Project members can create tasks
        allow create: if isMember(projectId) && request.resource.data.status == 'pending';

        // Update: enforce workflow transitions and role-based approval permissions
        allow update: if
          (
            // Leader transitions and leader metadata edits
            isLeader(projectId) &&
            (
              request.resource.data.status == resource.data.status ||
              (resource.data.status == 'pending' && request.resource.data.status == 'in_progress') ||
              (resource.data.status == 'submitted' && request.resource.data.status == 'in_progress') ||
              (resource.data.status == 'submitted' && request.resource.data.status == 'completed')
            )
          )
          ||
          (
            // Assigned member transitions up to submitted
            isMember(projectId) &&
            resource.data.assignedTo == request.auth.uid &&
            (
              (resource.data.status == 'pending' && request.resource.data.status == 'in_progress') ||
              (
                resource.data.status == 'in_progress' &&
                request.resource.data.status == 'submitted' &&
                request.resource.data.submittedByUid == request.auth.uid &&
                request.resource.data.submittedAt != null &&
                request.resource.data.approvedAt == null
              )
            )
          );

        // Delete: Task creator or project leader can delete
        allow delete: if isMember(projectId) && (resource.data.createdBy == request.auth.uid || isLeader(projectId));
      }
    }
  }
}
